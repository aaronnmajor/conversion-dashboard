<Page x:Class="ConversionDashboard.Views.DatabaseMonitorView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1080"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header and Controls -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Database Monitor" Style="{StaticResource HeaderStyle}"/>
            
            <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Control Panel -->
                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <CheckBox x:Name="AutoRefreshCheckBox" 
                                 Content="Auto-refresh" 
                                 IsChecked="True"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Margin="0,0,15,0"
                                 Checked="AutoRefresh_Changed"
                                 Unchecked="AutoRefresh_Changed"/>
                        
                        <TextBlock Text="Interval:" 
                                  VerticalAlignment="Center"
                                  Margin="0,0,5,0"
                                  FontSize="14"/>
                        <ComboBox x:Name="RefreshIntervalComboBox" 
                                 Width="120"
                                 SelectedIndex="1"
                                 FontSize="14"
                                 Margin="0,0,15,0"
                                 SelectionChanged="RefreshInterval_Changed">
                            <ComboBoxItem Content="5 seconds"/>
                            <ComboBoxItem Content="10 seconds"/>
                            <ComboBoxItem Content="30 seconds"/>
                            <ComboBoxItem Content="60 seconds"/>
                        </ComboBox>
                        
                        <TextBlock x:Name="LastRefreshText" 
                                  Text="Last refresh: Never"
                                  VerticalAlignment="Center"
                                  FontSize="12"
                                  Foreground="{StaticResource SecondaryTextBrush}"
                                  Margin="15,0,0,0"/>
                    </WrapPanel>

                    <!-- Action Buttons -->
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                        <Button Content="🔄 Refresh Now" 
                               Style="{StaticResource PrimaryButtonStyle}"
                               Click="RefreshNow_Click"
                               Margin="0,0,10,0"/>
                        <Button Content="📊 Export Data" 
                               Style="{StaticResource SuccessButtonStyle}"
                               Click="ExportData_Click"
                               Margin="0,0,10,0"/>
                        <Button Content="⚙️ Configure Query" 
                               Style="{StaticResource PrimaryButtonStyle}"
                               Click="ConfigureQuery_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Main Content Area with Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- Active Conversions Tab -->
            <TabItem Header="Active Conversions" FontSize="14">
                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Currently Active Conversion Jobs" 
                                  Style="{StaticResource SubHeaderStyle}"
                                  Grid.Row="0"/>

                        <DataGrid x:Name="ActiveConversionsGrid"
                                 Grid.Row="1"
                                 Style="{StaticResource ModernDataGridStyle}"
                                 AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="Job Name" Binding="{Binding JobName}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Start Time" Binding="{Binding StartTime}" Width="150"/>
                                <DataGridTextColumn Header="Elapsed" Binding="{Binding Elapsed}" Width="100"/>
                                <DataGridTextColumn Header="Progress" Binding="{Binding Progress}" Width="100"/>
                                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Conversion Queue Tab -->
            <TabItem Header="Conversion Queue" FontSize="14">
                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Pending Conversion Jobs in Queue" 
                                  Style="{StaticResource SubHeaderStyle}"
                                  Grid.Row="0"/>

                        <DataGrid x:Name="QueuedJobsGrid"
                                 Grid.Row="1"
                                 Style="{StaticResource ModernDataGridStyle}"
                                 AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="80"/>
                                <DataGridTextColumn Header="Job Name" Binding="{Binding JobName}" Width="*"/>
                                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="100"/>
                                <DataGridTextColumn Header="Queued At" Binding="{Binding QueuedAt}" Width="150"/>
                                <DataGridTextColumn Header="Estimated Size" Binding="{Binding EstimatedSize}" Width="120"/>
                                <DataGridTextColumn Header="Submitted By" Binding="{Binding SubmittedBy}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Error Log Tab -->
            <TabItem Header="Error Log" FontSize="14">
                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="Recent Errors and Warnings" 
                                      Style="{StaticResource SubHeaderStyle}"/>
                            <Button Content="Clear All" 
                                   Style="{StaticResource DangerButtonStyle}"
                                   Click="ClearErrors_Click"
                                   Margin="20,0,0,0"
                                   VerticalAlignment="Center"
                                   Padding="10,5"/>
                        </StackPanel>

                        <DataGrid x:Name="ErrorLogGrid"
                                 Grid.Row="1"
                                 Style="{StaticResource ModernDataGridStyle}"
                                 AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="150"/>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="Error">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                </Trigger>
                                                <Trigger Property="Text" Value="Warning">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Job" Binding="{Binding JobName}" Width="200"/>
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                                <DataGridTextColumn Header="Code" Binding="{Binding ErrorCode}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Statistics Tab -->
            <TabItem Header="Statistics" FontSize="14">
                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Conversion Statistics" Style="{StaticResource SubHeaderStyle}"/>
                            
                            <!-- Statistics Cards -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" 
                                       Background="{StaticResource AccentBrush}"
                                       CornerRadius="8"
                                       Padding="15"
                                       Margin="5">
                                    <StackPanel>
                                        <TextBlock Text="Total Conversions" 
                                                  Foreground="White"
                                                  FontSize="14"/>
                                        <TextBlock x:Name="TotalConversionsText" 
                                                  Text="1,234"
                                                  Foreground="White"
                                                  FontSize="32"
                                                  FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="1" 
                                       Background="{StaticResource SuccessBrush}"
                                       CornerRadius="8"
                                       Padding="15"
                                       Margin="5">
                                    <StackPanel>
                                        <TextBlock Text="Success Rate" 
                                                  Foreground="White"
                                                  FontSize="14"/>
                                        <TextBlock x:Name="SuccessRateText" 
                                                  Text="97.5%"
                                                  Foreground="White"
                                                  FontSize="32"
                                                  FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="2" 
                                       Background="{StaticResource WarningBrush}"
                                       CornerRadius="8"
                                       Padding="15"
                                       Margin="5">
                                    <StackPanel>
                                        <TextBlock Text="Avg Duration" 
                                                  Foreground="White"
                                                  FontSize="14"/>
                                        <TextBlock x:Name="AvgDurationText" 
                                                  Text="00:15:30"
                                                  Foreground="White"
                                                  FontSize="32"
                                                  FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" 
                                       Background="{StaticResource DangerBrush}"
                                       CornerRadius="8"
                                       Padding="15"
                                       Margin="5">
                                    <StackPanel>
                                        <TextBlock Text="Failed Today" 
                                                  Foreground="White"
                                                  FontSize="14"/>
                                        <TextBlock x:Name="FailedTodayText" 
                                                  Text="5"
                                                  Foreground="White"
                                                  FontSize="32"
                                                  FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="1" 
                                       Background="#9B59B6"
                                       CornerRadius="8"
                                       Padding="15"
                                       Margin="5">
                                    <StackPanel>
                                        <TextBlock Text="Records Processed" 
                                                  Foreground="White"
                                                  FontSize="14"/>
                                        <TextBlock x:Name="RecordsProcessedText" 
                                                  Text="5.2M"
                                                  Foreground="White"
                                                  FontSize="32"
                                                  FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="2" 
                                       Background="#16A085"
                                       CornerRadius="8"
                                       Padding="15"
                                       Margin="5">
                                    <StackPanel>
                                        <TextBlock Text="Data Volume" 
                                                  Foreground="White"
                                                  FontSize="14"/>
                                        <TextBlock x:Name="DataVolumeText" 
                                                  Text="128 GB"
                                                  Foreground="White"
                                                  FontSize="32"
                                                  FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Recent Activity Chart Placeholder -->
                            <TextBlock Text="Conversion Activity (Last 24 Hours)" 
                                      Style="{StaticResource SubHeaderStyle}"
                                      Margin="0,20,0,0"/>
                            <Border Background="White" 
                                   BorderBrush="{StaticResource BorderBrush}"
                                   BorderThickness="1"
                                   CornerRadius="5"
                                   Height="200"
                                   Margin="0,10,0,0">
                                <TextBlock Text="📊 Chart visualization would appear here"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          FontSize="16"
                                          Foreground="{StaticResource SecondaryTextBrush}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
