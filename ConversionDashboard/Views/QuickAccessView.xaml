<Page x:Class="ConversionDashboard.Views.QuickAccessView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1080"
      Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Quick Access" Style="{StaticResource HeaderStyle}"/>
            
            <!-- Important Directories -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Important Directories" Style="{StaticResource SubHeaderStyle}"/>
                    
                    <Grid Margin="0,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Working Directory -->
                        <TextBlock Text="📁 Working Dir:" Grid.Row="0" Grid.Column="0" 
                                  VerticalAlignment="Center" FontSize="14" Margin="0,5"/>
                        <TextBox x:Name="WorkingDirPath" Grid.Row="0" Grid.Column="1" 
                                Text="C:\ConversionData" IsReadOnly="True"
                                Style="{StaticResource ModernTextBoxStyle}" Margin="5"/>
                        <Button Content="Open" Grid.Row="0" Grid.Column="2" 
                               Style="{StaticResource PrimaryButtonStyle}"
                               Click="OpenWorkingDir_Click" Margin="5"/>

                        <!-- Logs Directory -->
                        <TextBlock Text="📄 Logs:" Grid.Row="1" Grid.Column="0" 
                                  VerticalAlignment="Center" FontSize="14" Margin="0,5"/>
                        <TextBox x:Name="LogsDirPath" Grid.Row="1" Grid.Column="1" 
                                Text="C:\ConversionData\Logs" IsReadOnly="True"
                                Style="{StaticResource ModernTextBoxStyle}" Margin="5"/>
                        <Button Content="Open" Grid.Row="1" Grid.Column="2" 
                               Style="{StaticResource PrimaryButtonStyle}"
                               Click="OpenLogsDir_Click" Margin="5"/>

                        <!-- Config Directory -->
                        <TextBlock Text="⚙️ Config:" Grid.Row="2" Grid.Column="0" 
                                  VerticalAlignment="Center" FontSize="14" Margin="0,5"/>
                        <TextBox x:Name="ConfigDirPath" Grid.Row="2" Grid.Column="1" 
                                Text="C:\ConversionData\Config" IsReadOnly="True"
                                Style="{StaticResource ModernTextBoxStyle}" Margin="5"/>
                        <Button Content="Open" Grid.Row="2" Grid.Column="2" 
                               Style="{StaticResource PrimaryButtonStyle}"
                               Click="OpenConfigDir_Click" Margin="5"/>

                        <!-- Output Directory -->
                        <TextBlock Text="📤 Output:" Grid.Row="3" Grid.Column="0" 
                                  VerticalAlignment="Center" FontSize="14" Margin="0,5"/>
                        <TextBox x:Name="OutputDirPath" Grid.Row="3" Grid.Column="1" 
                                Text="C:\ConversionData\Output" IsReadOnly="True"
                                Style="{StaticResource ModernTextBoxStyle}" Margin="5"/>
                        <Button Content="Open" Grid.Row="3" Grid.Column="2" 
                               Style="{StaticResource PrimaryButtonStyle}"
                               Click="OpenOutputDir_Click" Margin="5"/>

                        <!-- Archive Directory -->
                        <TextBlock Text="📦 Archive:" Grid.Row="4" Grid.Column="0" 
                                  VerticalAlignment="Center" FontSize="14" Margin="0,5"/>
                        <TextBox x:Name="ArchiveDirPath" Grid.Row="4" Grid.Column="1" 
                                Text="C:\ConversionData\Archive" IsReadOnly="True"
                                Style="{StaticResource ModernTextBoxStyle}" Margin="5"/>
                        <Button Content="Open" Grid.Row="4" Grid.Column="2" 
                               Style="{StaticResource PrimaryButtonStyle}"
                               Click="OpenArchiveDir_Click" Margin="5"/>

                        <!-- Temp Directory -->
                        <TextBlock Text="🗂️ Temp:" Grid.Row="5" Grid.Column="0" 
                                  VerticalAlignment="Center" FontSize="14" Margin="0,5"/>
                        <TextBox x:Name="TempDirPath" Grid.Row="5" Grid.Column="1" 
                                Text="C:\ConversionData\Temp" IsReadOnly="True"
                                Style="{StaticResource ModernTextBoxStyle}" Margin="5"/>
                        <Button Content="Open" Grid.Row="5" Grid.Column="2" 
                               Style="{StaticResource PrimaryButtonStyle}"
                               Click="OpenTempDir_Click" Margin="5"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Important Files -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Important Files" Style="{StaticResource SubHeaderStyle}"/>
                    
                    <Grid Margin="0,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- App Config File -->
                        <TextBlock Text="📋 App Config:" Grid.Row="0" Grid.Column="0" 
                                  VerticalAlignment="Center" FontSize="14" Margin="0,5"/>
                        <TextBox Grid.Row="0" Grid.Column="1" 
                                Text="C:\ConversionData\Config\app.config" IsReadOnly="True"
                                Style="{StaticResource ModernTextBoxStyle}" Margin="5"/>
                        <Button Content="Open" Grid.Row="0" Grid.Column="2" 
                               Style="{StaticResource PrimaryButtonStyle}"
                               Click="OpenAppConfig_Click" Margin="5"/>
                        <Button Content="Edit" Grid.Row="0" Grid.Column="3" 
                               Style="{StaticResource SuccessButtonStyle}"
                               Click="EditAppConfig_Click" Margin="5"/>

                        <!-- Database Config -->
                        <TextBlock Text="💾 DB Config:" Grid.Row="1" Grid.Column="0" 
                                  VerticalAlignment="Center" FontSize="14" Margin="0,5"/>
                        <TextBox Grid.Row="1" Grid.Column="1" 
                                Text="C:\ConversionData\Config\database.config" IsReadOnly="True"
                                Style="{StaticResource ModernTextBoxStyle}" Margin="5"/>
                        <Button Content="Open" Grid.Row="1" Grid.Column="2" 
                               Style="{StaticResource PrimaryButtonStyle}"
                               Click="OpenDbConfig_Click" Margin="5"/>
                        <Button Content="Edit" Grid.Row="1" Grid.Column="3" 
                               Style="{StaticResource SuccessButtonStyle}"
                               Click="EditDbConfig_Click" Margin="5"/>

                        <!-- Current Log File -->
                        <TextBlock Text="📝 Current Log:" Grid.Row="2" Grid.Column="0" 
                                  VerticalAlignment="Center" FontSize="14" Margin="0,5"/>
                        <TextBox Grid.Row="2" Grid.Column="1" 
                                Text="C:\ConversionData\Logs\app.log" IsReadOnly="True"
                                Style="{StaticResource ModernTextBoxStyle}" Margin="5"/>
                        <Button Content="View" Grid.Row="2" Grid.Column="2" 
                               Style="{StaticResource PrimaryButtonStyle}"
                               Click="ViewCurrentLog_Click" Margin="5"/>
                        <Button Content="Clear" Grid.Row="2" Grid.Column="3" 
                               Style="{StaticResource DangerButtonStyle}"
                               Click="ClearCurrentLog_Click" Margin="5"/>

                        <!-- Error Log File -->
                        <TextBlock Text="⚠️ Error Log:" Grid.Row="3" Grid.Column="0" 
                                  VerticalAlignment="Center" FontSize="14" Margin="0,5"/>
                        <TextBox Grid.Row="3" Grid.Column="1" 
                                Text="C:\ConversionData\Logs\error.log" IsReadOnly="True"
                                Style="{StaticResource ModernTextBoxStyle}" Margin="5"/>
                        <Button Content="View" Grid.Row="3" Grid.Column="2" 
                               Style="{StaticResource PrimaryButtonStyle}"
                               Click="ViewErrorLog_Click" Margin="5"/>
                        <Button Content="Clear" Grid.Row="3" Grid.Column="3" 
                               Style="{StaticResource DangerButtonStyle}"
                               Click="ClearErrorLog_Click" Margin="5"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Quick Actions -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Directory Actions" Style="{StaticResource SubHeaderStyle}"/>
                    <WrapPanel>
                        <Button Content="Create All Directories" 
                               Style="{StaticResource SuccessButtonStyle}"
                               Click="CreateAllDirectories_Click"
                               Margin="0,0,10,10"/>
                        <Button Content="Clean Temp Files" 
                               Style="{StaticResource PrimaryButtonStyle}"
                               Click="CleanTempFiles_Click"
                               Margin="0,0,10,10"/>
                        <Button Content="Archive Old Logs" 
                               Style="{StaticResource PrimaryButtonStyle}"
                               Click="ArchiveOldLogs_Click"
                               Margin="0,0,10,10"/>
                        <Button Content="Backup Configuration" 
                               Style="{StaticResource SuccessButtonStyle}"
                               Click="BackupConfig_Click"
                               Margin="0,0,10,10"/>
                        <Button Content="Refresh Paths" 
                               Style="{StaticResource PrimaryButtonStyle}"
                               Click="RefreshPaths_Click"
                               Margin="0,0,10,10"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
