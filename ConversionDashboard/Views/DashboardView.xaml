<Page x:Class="ConversionDashboard.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1080"
      Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Dashboard Overview" Style="{StaticResource HeaderStyle}"/>
            
            <!-- Stats Cards -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Jobs Card -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="📊 Total Jobs" 
                                  FontSize="16" 
                                  Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="TotalJobsText" 
                                  Text="0" 
                                  FontSize="36" 
                                  FontWeight="Bold"
                                  Foreground="{StaticResource AccentBrush}"
                                  Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Active Jobs Card -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="⚡ Active Jobs" 
                                  FontSize="16" 
                                  Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="ActiveJobsText" 
                                  Text="0" 
                                  FontSize="36" 
                                  FontWeight="Bold"
                                  Foreground="{StaticResource SuccessBrush}"
                                  Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Failed Jobs Card -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="❌ Failed Jobs" 
                                  FontSize="16" 
                                  Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="FailedJobsText" 
                                  Text="0" 
                                  FontSize="36" 
                                  FontWeight="Bold"
                                  Foreground="{StaticResource DangerBrush}"
                                  Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Database Status Card -->
                <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="💾 DB Status" 
                                  FontSize="16" 
                                  Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="DbStatusText" 
                                  Text="Connected" 
                                  FontSize="20" 
                                  FontWeight="Bold"
                                  Foreground="{StaticResource SuccessBrush}"
                                  Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent Activity -->
            <Border Style="{StaticResource CardStyle}" Margin="10,20,10,10">
                <StackPanel>
                    <TextBlock Text="Recent Activity" Style="{StaticResource SubHeaderStyle}"/>
                    <ListBox x:Name="ActivityListBox" 
                            Height="200"
                            BorderThickness="0"
                            Background="Transparent">
                        <ListBoxItem Content="✓ Conversion job completed successfully - 10:45 AM"/>
                        <ListBoxItem Content="ℹ Database sync started - 10:30 AM"/>
                        <ListBoxItem Content="✓ Configuration updated - 10:15 AM"/>
                        <ListBoxItem Content="⚠ Warning: High memory usage detected - 10:00 AM"/>
                        <ListBoxItem Content="✓ Log files archived - 09:45 AM"/>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Quick Actions -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Quick Actions" Style="{StaticResource SubHeaderStyle}"/>
                    <WrapPanel>
                        <Button Content="Run Conversion" 
                               Style="{StaticResource PrimaryButtonStyle}"
                               Margin="0,0,10,10"
                               Click="RunConversion_Click"/>
                        <Button Content="View Logs" 
                               Style="{StaticResource PrimaryButtonStyle}"
                               Margin="0,0,10,10"
                               Click="ViewLogs_Click"/>
                        <Button Content="Refresh Stats" 
                               Style="{StaticResource SuccessButtonStyle}"
                               Margin="0,0,10,10"
                               Click="RefreshStats_Click"/>
                        <Button Content="Open Settings" 
                               Style="{StaticResource PrimaryButtonStyle}"
                               Margin="0,0,10,10"
                               Click="OpenSettings_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
