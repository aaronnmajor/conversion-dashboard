<Page x:Class="ConversionDashboard.Views.JobsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1080"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Jobs Management" Style="{StaticResource HeaderStyle}"/>
            
            <!-- Action Buttons -->
            <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,10">
                <WrapPanel>
                    <Button Content="▶️ Run Selected Job" 
                           Style="{StaticResource SuccessButtonStyle}"
                           Click="RunJob_Click"
                           Margin="0,0,10,0"/>
                    <Button Content="⏸️ Pause Selected Job" 
                           Style="{StaticResource WarningButtonStyle}"
                           Click="PauseJob_Click"
                           Margin="0,0,10,0"/>
                    <Button Content="⏹️ Stop Selected Job" 
                           Style="{StaticResource DangerButtonStyle}"
                           Click="StopJob_Click"
                           Margin="0,0,10,0"/>
                    <Button Content="🔄 Refresh Status" 
                           Style="{StaticResource PrimaryButtonStyle}"
                           Click="RefreshJobs_Click"
                           Margin="0,0,10,0"/>
                    <Button Content="📋 View Logs" 
                           Style="{StaticResource PrimaryButtonStyle}"
                           Click="ViewJobLogs_Click"
                           Margin="0,0,10,0"/>
                    <Button Content="➕ New Job" 
                           Style="{StaticResource SuccessButtonStyle}"
                           Click="CreateNewJob_Click"/>
                </WrapPanel>
            </Border>
        </StackPanel>

        <!-- Jobs List -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <DataGrid x:Name="JobsDataGrid"
                     Style="{StaticResource ModernDataGridStyle}"
                     AutoGenerateColumns="False"
                     SelectionChanged="JobsDataGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Job ID" Binding="{Binding JobId}" Width="80"/>
                    <DataGridTextColumn Header="Job Name" Binding="{Binding JobName}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="Running">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="Completed">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="Failed">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="Pending">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Progress" Binding="{Binding Progress}" Width="100"/>
                    <DataGridTextColumn Header="Start Time" Binding="{Binding StartTime}" Width="150"/>
                    <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="100"/>
                    <DataGridTextColumn Header="Records Processed" Binding="{Binding RecordsProcessed}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Job Details Panel -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Job Details" Style="{StaticResource SubHeaderStyle}"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Job Name:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="DetailJobName" 
                                  Text="Select a job to view details"
                                  FontSize="16"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="Job Type:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="DetailJobType" 
                                  Text="-"
                                  FontSize="14"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="Status:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="DetailStatus" 
                                  Text="-"
                                  FontSize="14"
                                  FontWeight="Bold"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="Progress:" Style="{StaticResource LabelStyle}"/>
                        <ProgressBar x:Name="DetailProgressBar" 
                                    Height="25"
                                    Value="0"
                                    Maximum="100"
                                    Margin="0,0,0,10"/>
                    </StackPanel>

                    <!-- Right Column -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Last Run:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="DetailLastRun" 
                                  Text="-"
                                  FontSize="14"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="Duration:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="DetailDuration" 
                                  Text="-"
                                  FontSize="14"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="Records Processed:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="DetailRecordsProcessed" 
                                  Text="-"
                                  FontSize="14"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="Last Message:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="DetailLastMessage" 
                                  Text="-"
                                  FontSize="12"
                                  TextWrapping="Wrap"
                                  Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
