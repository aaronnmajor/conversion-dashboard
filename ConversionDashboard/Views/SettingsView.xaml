<Page x:Class="ConversionDashboard.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1080"
      Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Settings" Style="{StaticResource HeaderStyle}"/>
            
            <!-- General Settings -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="General Settings" Style="{StaticResource SubHeaderStyle}"/>
                    
                    <TextBlock Text="Application Name" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="AppNameTextBox" 
                            Text="Conversion Dashboard"
                            Style="{StaticResource ModernTextBoxStyle}"
                            Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Working Directory" Style="{StaticResource LabelStyle}"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WorkingDirTextBox" 
                                Text="C:\ConversionData"
                                Style="{StaticResource ModernTextBoxStyle}"
                                Grid.Column="0"
                                Margin="0,0,10,0"/>
                        <Button Content="Browse..." 
                               Style="{StaticResource PrimaryButtonStyle}"
                               Grid.Column="1"
                               Click="BrowseWorkingDir_Click"/>
                    </Grid>
                    
                    <CheckBox x:Name="AutoStartCheckBox" 
                             Content="Start application with Windows"
                             Margin="0,0,0,10"
                             FontSize="14"/>
                    
                    <CheckBox x:Name="MinimizeToTrayCheckBox" 
                             Content="Minimize to system tray"
                             Margin="0,0,0,10"
                             FontSize="14"/>
                </StackPanel>
            </Border>

            <!-- Database Settings -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Database Settings" Style="{StaticResource SubHeaderStyle}"/>
                    
                    <TextBlock Text="Server Address" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="DbServerTextBox" 
                            Text="localhost"
                            Style="{StaticResource ModernTextBoxStyle}"
                            Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Database Name" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="DbNameTextBox" 
                            Text="ConversionDB"
                            Style="{StaticResource ModernTextBoxStyle}"
                            Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Username" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="DbUsernameTextBox" 
                            Text="admin"
                            Style="{StaticResource ModernTextBoxStyle}"
                            Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Connection Timeout (seconds)" Style="{StaticResource LabelStyle}"/>
                    <Slider x:Name="TimeoutSlider" 
                           Minimum="5" 
                           Maximum="120" 
                           Value="30"
                           TickFrequency="5"
                           IsSnapToTickEnabled="True"
                           Margin="0,0,0,5"/>
                    <TextBlock x:Name="TimeoutValueText" 
                              Text="30 seconds"
                              Foreground="{StaticResource AccentBrush}"
                              Margin="0,0,0,15"/>
                    
                    <Button Content="Test Connection" 
                           Style="{StaticResource PrimaryButtonStyle}"
                           Click="TestConnection_Click"
                           Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Notification Settings -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Notification Settings" Style="{StaticResource SubHeaderStyle}"/>
                    
                    <CheckBox x:Name="EnableNotificationsCheckBox" 
                             Content="Enable notifications"
                             IsChecked="True"
                             Margin="0,0,0,10"
                             FontSize="14"/>
                    
                    <CheckBox x:Name="EmailAlertsCheckBox" 
                             Content="Send email alerts on job failures"
                             IsChecked="True"
                             Margin="0,0,0,10"
                             FontSize="14"/>
                    
                    <TextBlock Text="Email Recipients (comma-separated)" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="EmailRecipientsTextBox" 
                            Text="admin@example.com"
                            Style="{StaticResource ModernTextBoxStyle}"
                            Margin="0,0,0,15"/>
                </StackPanel>
            </Border>

            <!-- Polling Settings -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Polling &amp; Refresh Settings" Style="{StaticResource SubHeaderStyle}"/>
                    
                    <TextBlock Text="Database Poll Interval (seconds)" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="PollIntervalComboBox" 
                             SelectedIndex="1"
                             FontSize="14"
                             Margin="0,0,0,15">
                        <ComboBoxItem Content="5 seconds"/>
                        <ComboBoxItem Content="10 seconds"/>
                        <ComboBoxItem Content="30 seconds"/>
                        <ComboBoxItem Content="60 seconds"/>
                        <ComboBoxItem Content="120 seconds"/>
                    </ComboBox>
                    
                    <TextBlock Text="Dashboard Refresh Rate" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="RefreshRateComboBox" 
                             SelectedIndex="2"
                             FontSize="14"
                             Margin="0,0,0,15">
                        <ComboBoxItem Content="Real-time"/>
                        <ComboBoxItem Content="Every 5 seconds"/>
                        <ComboBoxItem Content="Every 30 seconds"/>
                        <ComboBoxItem Content="Every minute"/>
                        <ComboBoxItem Content="Manual only"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <Border Style="{StaticResource CardStyle}">
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="Save Settings" 
                           Style="{StaticResource SuccessButtonStyle}"
                           Margin="0,0,10,0"
                           Click="SaveSettings_Click"/>
                    <Button Content="Reset to Defaults" 
                           Style="{StaticResource DangerButtonStyle}"
                           Click="ResetSettings_Click"/>
                </WrapPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
