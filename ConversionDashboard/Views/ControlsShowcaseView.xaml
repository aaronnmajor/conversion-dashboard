<Page x:Class="ConversionDashboard.Views.ControlsShowcaseView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1080"
      Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="WPF Controls Showcase" Style="{StaticResource HeaderStyle}"/>
            
            <!-- Buttons -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Buttons" Style="{StaticResource SubHeaderStyle}"/>
                    <WrapPanel>
                        <Button Content="Primary Button" 
                               Style="{StaticResource PrimaryButtonStyle}"
                               Margin="0,0,10,10"/>
                        <Button Content="Success Button" 
                               Style="{StaticResource SuccessButtonStyle}"
                               Margin="0,0,10,10"/>
                        <Button Content="Danger Button" 
                               Style="{StaticResource DangerButtonStyle}"
                               Margin="0,0,10,10"/>
                        <Button Content="Disabled Button" 
                               Style="{StaticResource PrimaryButtonStyle}"
                               IsEnabled="False"
                               Margin="0,0,10,10"/>
                        <Button Content="Button with Icon 🔍" 
                               Style="{StaticResource PrimaryButtonStyle}"
                               Margin="0,0,10,10"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Text Input Controls -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Text Input Controls" Style="{StaticResource SubHeaderStyle}"/>
                    
                    <TextBlock Text="TextBox:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="Sample text input" 
                            Style="{StaticResource ModernTextBoxStyle}"
                            Margin="0,0,0,15"/>
                    
                    <TextBlock Text="PasswordBox:" Style="{StaticResource LabelStyle}"/>
                    <PasswordBox Password="password" 
                                Padding="10"
                                FontSize="14"
                                Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Multi-line TextBox:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="Line 1&#x0a;Line 2&#x0a;Line 3" 
                            Style="{StaticResource ModernTextBoxStyle}"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            Height="80"
                            Margin="0,0,0,15"/>
                    
                    <TextBlock Text="ReadOnly TextBox:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="This text cannot be edited" 
                            Style="{StaticResource ModernTextBoxStyle}"
                            IsReadOnly="True"
                            Background="#F0F0F0"
                            Margin="0,0,0,15"/>
                </StackPanel>
            </Border>

            <!-- Selection Controls -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Selection Controls" Style="{StaticResource SubHeaderStyle}"/>
                    
                    <TextBlock Text="CheckBoxes:" Style="{StaticResource LabelStyle}"/>
                    <StackPanel Margin="0,0,0,15">
                        <CheckBox Content="Option 1" IsChecked="True" FontSize="14" Margin="0,0,0,5"/>
                        <CheckBox Content="Option 2" IsChecked="False" FontSize="14" Margin="0,0,0,5"/>
                        <CheckBox Content="Option 3 (Disabled)" IsEnabled="False" FontSize="14" Margin="0,0,0,5"/>
                    </StackPanel>
                    
                    <TextBlock Text="RadioButtons:" Style="{StaticResource LabelStyle}"/>
                    <StackPanel Margin="0,0,0,15">
                        <RadioButton Content="Choice A" IsChecked="True" GroupName="Group1" FontSize="14" Margin="0,0,0,5"/>
                        <RadioButton Content="Choice B" GroupName="Group1" FontSize="14" Margin="0,0,0,5"/>
                        <RadioButton Content="Choice C" GroupName="Group1" FontSize="14" Margin="0,0,0,5"/>
                    </StackPanel>
                    
                    <TextBlock Text="ComboBox:" Style="{StaticResource LabelStyle}"/>
                    <ComboBox SelectedIndex="0" FontSize="14" Margin="0,0,0,15">
                        <ComboBoxItem Content="Option 1"/>
                        <ComboBoxItem Content="Option 2"/>
                        <ComboBoxItem Content="Option 3"/>
                        <ComboBoxItem Content="Option 4"/>
                        <ComboBoxItem Content="Option 5"/>
                    </ComboBox>
                    
                    <TextBlock Text="Editable ComboBox:" Style="{StaticResource LabelStyle}"/>
                    <ComboBox IsEditable="True" Text="Type or select..." FontSize="14" Margin="0,0,0,15">
                        <ComboBoxItem Content="Apple"/>
                        <ComboBoxItem Content="Banana"/>
                        <ComboBoxItem Content="Cherry"/>
                        <ComboBoxItem Content="Date"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Range Controls -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Range &amp; Progress Controls" Style="{StaticResource SubHeaderStyle}"/>
                    
                    <TextBlock Text="Slider:" Style="{StaticResource LabelStyle}"/>
                    <Slider x:Name="SampleSlider" 
                           Minimum="0" 
                           Maximum="100" 
                           Value="50"
                           TickFrequency="10"
                           IsSnapToTickEnabled="True"
                           Margin="0,0,0,5"/>
                    <TextBlock x:Name="SliderValueText" 
                              Text="Value: 50"
                              FontSize="12"
                              Foreground="{StaticResource AccentBrush}"
                              Margin="0,0,0,15"/>
                    
                    <TextBlock Text="ProgressBar (Indeterminate):" Style="{StaticResource LabelStyle}"/>
                    <ProgressBar IsIndeterminate="True" 
                                Height="20"
                                Margin="0,0,0,15"/>
                    
                    <TextBlock Text="ProgressBar (Value-based):" Style="{StaticResource LabelStyle}"/>
                    <ProgressBar Value="75" 
                                Maximum="100"
                                Height="25"
                                Margin="0,0,0,5"/>
                    <TextBlock Text="75% Complete"
                              FontSize="12"
                              Foreground="{StaticResource AccentBrush}"
                              Margin="0,0,0,15"/>
                </StackPanel>
            </Border>

            <!-- List Controls -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="ListBox" Style="{StaticResource SubHeaderStyle}"/>
                        <ListBox Height="150" 
                                FontSize="14"
                                Margin="0,0,0,15">
                            <ListBoxItem Content="Item 1"/>
                            <ListBoxItem Content="Item 2" IsSelected="True"/>
                            <ListBoxItem Content="Item 3"/>
                            <ListBoxItem Content="Item 4"/>
                            <ListBoxItem Content="Item 5"/>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="ListView" Style="{StaticResource SubHeaderStyle}"/>
                        <ListView Height="150" 
                                 FontSize="14"
                                 Margin="0,0,0,15">
                            <ListViewItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄" Margin="0,0,5,0"/>
                                    <TextBlock Text="Document 1"/>
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁" Margin="0,0,5,0"/>
                                    <TextBlock Text="Folder"/>
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🖼️" Margin="0,0,5,0"/>
                                    <TextBlock Text="Image"/>
                                </StackPanel>
                            </ListViewItem>
                        </ListView>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Date and Time -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="DatePicker" Style="{StaticResource SubHeaderStyle}"/>
                        <DatePicker x:Name="SampleDatePicker"
                                   FontSize="14"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Calendar" Style="{StaticResource SubHeaderStyle}"/>
                        <Calendar x:Name="SampleCalendar"
                                 FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Grouping Controls -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Grouping Controls" Style="{StaticResource SubHeaderStyle}"/>
                    
                    <GroupBox Header="GroupBox Example" 
                             FontSize="14"
                             Margin="0,0,0,15">
                        <StackPanel Margin="10">
                            <TextBlock Text="Content inside a GroupBox" FontSize="12"/>
                            <Button Content="Action Button" 
                                   Style="{StaticResource PrimaryButtonStyle}"
                                   Margin="0,10,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <Expander Header="Expandable Section (Click to expand)" 
                             FontSize="14"
                             IsExpanded="False"
                             Margin="0,0,0,15">
                        <StackPanel Margin="10">
                            <TextBlock Text="This content is hidden until expanded" 
                                      FontSize="12"
                                      Margin="0,0,0,10"/>
                            <TextBlock Text="You can put any controls here" 
                                      FontSize="12"/>
                        </StackPanel>
                    </Expander>

                    <TabControl Height="150" FontSize="14">
                        <TabItem Header="Tab 1">
                            <TextBlock Text="Content for Tab 1" 
                                      Margin="10"
                                      VerticalAlignment="Center"/>
                        </TabItem>
                        <TabItem Header="Tab 2">
                            <TextBlock Text="Content for Tab 2" 
                                      Margin="10"
                                      VerticalAlignment="Center"/>
                        </TabItem>
                        <TabItem Header="Tab 3">
                            <TextBlock Text="Content for Tab 3" 
                                      Margin="10"
                                      VerticalAlignment="Center"/>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </Border>

            <!-- Menu and Toolbar -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Menu &amp; Toolbar" Style="{StaticResource SubHeaderStyle}"/>
                    
                    <TextBlock Text="Menu:" Style="{StaticResource LabelStyle}"/>
                    <Menu FontSize="14" Margin="0,0,0,15">
                        <MenuItem Header="File">
                            <MenuItem Header="New"/>
                            <MenuItem Header="Open"/>
                            <Separator/>
                            <MenuItem Header="Exit"/>
                        </MenuItem>
                        <MenuItem Header="Edit">
                            <MenuItem Header="Cut"/>
                            <MenuItem Header="Copy"/>
                            <MenuItem Header="Paste"/>
                        </MenuItem>
                        <MenuItem Header="Help">
                            <MenuItem Header="About"/>
                        </MenuItem>
                    </Menu>

                    <TextBlock Text="ToolBar:" Style="{StaticResource LabelStyle}"/>
                    <ToolBar FontSize="14">
                        <Button Content="New" Padding="5"/>
                        <Button Content="Open" Padding="5"/>
                        <Button Content="Save" Padding="5"/>
                        <Separator/>
                        <Button Content="Cut" Padding="5"/>
                        <Button Content="Copy" Padding="5"/>
                        <Button Content="Paste" Padding="5"/>
                    </ToolBar>
                </StackPanel>
            </Border>

            <!-- Data Display -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Data Display Controls" Style="{StaticResource SubHeaderStyle}"/>
                    
                    <TextBlock Text="DataGrid:" Style="{StaticResource LabelStyle}"/>
                    <DataGrid x:Name="SampleDataGrid"
                             Style="{StaticResource ModernDataGridStyle}"
                             Height="150"
                             AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Status and Information -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Status &amp; Information" Style="{StaticResource SubHeaderStyle}"/>
                    
                    <TextBlock Text="StatusBar:" Style="{StaticResource LabelStyle}"/>
                    <StatusBar Height="30" Margin="0,0,0,15">
                        <StatusBarItem>
                            <TextBlock Text="Ready"/>
                        </StatusBarItem>
                        <Separator/>
                        <StatusBarItem>
                            <TextBlock Text="Items: 10"/>
                        </StatusBarItem>
                        <Separator/>
                        <StatusBarItem HorizontalAlignment="Right">
                            <TextBlock Text="100%"/>
                        </StatusBarItem>
                    </StatusBar>

                    <TextBlock Text="ToolTip Example (Hover over button):" Style="{StaticResource LabelStyle}"/>
                    <Button Content="Hover Over Me" 
                           Style="{StaticResource PrimaryButtonStyle}"
                           ToolTip="This is a helpful tooltip!"
                           Width="150"
                           HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
