<Window x:Class="ConversionDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Conversion Dashboard" 
        Height="720" 
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation Sidebar -->
        <Border Grid.Column="0" 
                Background="{StaticResource SidebarBrush}"
                BorderThickness="0,0,1,0"
                BorderBrush="{StaticResource BorderBrush}">
            <StackPanel Margin="10">
                <TextBlock Text="CONVERSION DASHBOARD" 
                          FontWeight="Bold" 
                          FontSize="14"
                          Foreground="{StaticResource PrimaryTextBrush}"
                          Margin="0,0,0,30"
                          TextWrapping="Wrap"/>
                
                <!-- Navigation Buttons -->
                <Button x:Name="DashboardButton" 
                        Content="📊 Dashboard" 
                        Style="{StaticResource NavigationButtonStyle}"
                        Click="DashboardButton_Click"/>
                
                <Button x:Name="SettingsButton" 
                        Content="⚙️ Settings" 
                        Style="{StaticResource NavigationButtonStyle}"
                        Click="SettingsButton_Click"/>
                
                <Button x:Name="QuickAccessButton" 
                        Content="📁 Quick Access" 
                        Style="{StaticResource NavigationButtonStyle}"
                        Click="QuickAccessButton_Click"/>
                
                <Button x:Name="JobsButton" 
                        Content="⚡ Jobs" 
                        Style="{StaticResource NavigationButtonStyle}"
                        Click="JobsButton_Click"/>
                
                <Button x:Name="DatabaseMonitorButton" 
                        Content="💾 DB Monitor" 
                        Style="{StaticResource NavigationButtonStyle}"
                        Click="DatabaseMonitorButton_Click"/>
                
                <Button x:Name="ControlsButton" 
                        Content="🎨 Controls" 
                        Style="{StaticResource NavigationButtonStyle}"
                        Click="ControlsButton_Click"/>
                
                <!-- Status Bar at bottom -->
                <Border Background="{StaticResource AccentBrush}" 
                        CornerRadius="5"
                        Padding="10"
                        Margin="0,30,0,0">
                    <StackPanel>
                        <TextBlock Text="Status" 
                                  FontWeight="Bold"
                                  Foreground="White"
                                  Margin="0,0,0,5"/>
                        <TextBlock x:Name="StatusText" 
                                  Text="Ready" 
                                  Foreground="White"
                                  TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <Border Grid.Column="1" Margin="0">
            <Frame x:Name="ContentFrame" 
                   NavigationUIVisibility="Hidden"
                   Background="Transparent"/>
        </Border>
    </Grid>
</Window>
